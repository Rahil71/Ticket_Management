# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://admin:admin@expresscluster.3ck47o2.mongodb.net/TMProjectNew

# Tenant (for dev testing — fixed tenant ObjectId)
DEV_TENANT_ID=665f1a2b3c4d5e6f7a8b9c0d

# Dev user (for dev testing — acts as both agent and customer requester)
DEV_USER_ID=665f1a2b3c4d5e6f7a8b9c0e
DEV_CUSTOMER_ID=665f1a2b3c4d5e6f7a8b9c0f

# Dev role — controls which role-gated routes are accessible during development.
# Options: ADMIN | AGENT | CUSTOMER
# Set to ADMIN to access form-designer and catalogue management endpoints.
# Set to CUSTOMER to test portal-only routes.
# In production Team 1's JWT middleware populates this from the token claims.
DEV_USER_ROLE=AGENT

# Ticket reopen window (days). Customers may only reopen within this period after resolution.
# Set to 0 to disable the time window check (allow reopen any time).
REOPEN_WINDOW_DAYS=30

# ─── Team 6 Integration — Workflow, Assignment, Priority & SLA ────────────────
# Base URL for Team 6's backend API.
# Local development default: http://localhost:5000/api
# When Team 6 deploys to Render or Vercel, replace the value below with their
# live URL, e.g.:
#   TEAM6_API_BASE_URL=https://team6-backend.onrender.com/api
#   TEAM6_API_BASE_URL=https://team6-backend.vercel.app/api
TEAM6_API_BASE_URL=http://localhost:5000/api
